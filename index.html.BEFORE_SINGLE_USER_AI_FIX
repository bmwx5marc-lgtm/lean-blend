function setCustomGoal(goal,btn){
 customGoal=goal;
 document.querySelectorAll('#goalSelect button').forEach(b=>b.classList.remove('active')); btn.classList.add('active');
 const tips={all:"Choose a goal to prioritise ingredients. You remain in control of the final recipe.",gut:"Prioritise fermented dairy, kiwi, berries and measured fibre.",inflammation:"Prioritise berries, flax, chia, ginger, cinnamon and cocoa.",gentle:"Prioritise lower-acid, creamy ingredients and avoid citrus if it doesn't suit you.",satiety:"Build around protein + fibre + volume + a measured fat source.",hydration:"Start with fluid, then add water-rich produce and herbs.",energy:"Use caffeine deliberately and pair it with protein and whole-food carbohydrate."};
 document.getElementById('goalTip').textContent=tips[goal];
 const priority=goalMap[goal]||[];
 document.querySelectorAll('#pickGrid .pick').forEach(card=>{
   const name=card.dataset.name||"";
   card.style.order=priority.includes(name)?-1:0;
   card.style.display=(goal==='all'||priority.includes(name)||card.dataset.category==='LIQUID'||card.dataset.category==='FRUIT'||card.dataset.category==='BOOSTER'||card.dataset.category==='PROTEIN'||card.dataset.category==='CREAMY'||card.dataset.category==='VEG')?'block':'block';
 });
