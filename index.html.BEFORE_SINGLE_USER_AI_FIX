  async function analysePhoto(dataUrl){const aiProfile=ensureAIProfile(); if(!aiProfile){return}setStatus('lb-v25-status','READING PHOTO…');try{showFood(await aiPost('/food-photo',{image:dataUrl,meal:meal(),date:today(),context}),'AI VISION ESTIMATE')}catch(e){setStatus('lb-v25-status','ERROR');alert(e.message)}}
  window.leanBlendAnalyseCapture=analyseCapture; $('lb-v25-analyse')?.addEventListener('click',analyseCapture); $('lb-v25-photo')?.addEventListener('click',()=>$('lb-v25-file')?.click());
  document.querySelectorAll('.lb-meal-chip').forEach(chip=>chip.addEventListener('click',()=>{document.querySelectorAll('.lb-meal-chip').forEach(x=>x.classList.remove('active'));chip.classList.add('active');const sel=$('lb-v25-meal');if(sel)sel.value=chip.dataset.meal||'Snack';}));$('lb-v25-file')?.addEventListener('change',e=>{const f=e.target.files?.[0];if(!f)return;const reader=new FileReader();reader.onload=()=>analysePhoto(reader.result);reader.readAsDataURL(f);e.target.value='';});
  $('lb-v25-voice')?.addEventListener('click',()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){alert('Voice input is not supported in this browser. Use text capture instead.');return}const r=new SR();r.lang='en-ZA';r.interimResults=false;r.maxAlternatives=1;r.onstart=()=>setStatus('lb-v25-status','LISTENING…');r.onresult=e=>{$('lb-v25-text').value=e.results[0][0].transcript;setStatus('lb-v25-status','VOICE CAPTURED')};r.onerror=()=>setStatus('lb-v25-status','VOICE ERROR');r.onend=()=>{};r.start();});
  $('lb-v25-preview-rows')?.addEventListener('input',e=>{const el=e.target;if(!el.dataset.v26)return;const i=Number(el.dataset.i),k=el.dataset.v26;if(pending[i])pending[i][k]=k==='name'?el.value:Number(el.value)||0});
  $('lb-v25-confirm')?.addEventListener('click',()=>{const p=profile();if(!p||!pending.length)return;p.foodLog=p.foodLog||[];pending.forEach(x=>p.foodLog.push(x));window.leanBlendSaveProfile?.();pending=[];$('lb-v25-preview').hidden=true;$('lb-v25-text').value='';setStatus('lb-v25-status','LOGGED ✓');window.leanBlendRender?.();setTimeout(()=>setStatus('lb-v25-status','READY'),1500)});
  $('lb-v25-cancel')?.addEventListener('click',()=>{pending=[];$('lb-v25-preview').hidden=true;setStatus('lb-v25-status','READY')});
  // ---- MANUAL FOOD + LOCAL DASHBOARD ----
  $('lb-add-food')?.addEventListener('click',()=>{const p=profile();if(!p){return}const name=$('lb-food-name').value.trim(),kcal=Number($('lb-food-kcal-input').value);if(!name||!Number.isFinite(kcal)||kcal<0){alert('Enter a food description and calories.');return}p.foodLog=p.foodLog||[];p.foodLog.push({date:$('lb-food-date').value||today(),meal:$('lb-food-meal').value,name,kcal,protein:Number($('lb-food-protein-input').value)||0,carbs:Number($('lb-food-carbs-input').value)||0,fat:Number($('lb-food-fat-input').value)||0,fibre:Number($('lb-food-fibre-input').value)||0,source:'MANUAL'});window.leanBlendSaveProfile?.();['lb-food-name','lb-food-kcal-input','lb-food-protein-input','lb-food-carbs-input','lb-food-fat-input','lb-food-fibre-input'].forEach(id=>$(id).value='');window.leanBlendRender?.();});
  $('lb-clear-food-day')?.addEventListener('click',()=>{const p=profile();if(!p)return;if(confirm('Clear all food logged for today?')){p.foodLog=(p.foodLog||[]).filter(x=>x.date!==today());window.leanBlendSaveProfile?.();window.leanBlendRender?.()}});
  // ---- GARMIN ----
  function renderGarmin(){const p=profile(),days=p?.garmin?.days||[];const avg=k=>{const v=days.map(x=>Number(x[k])).filter(Number.isFinite);return v.length?v.reduce((a,b)=>a+b,0)/v.length:null};$('lb-garmin-steps').textContent=avg('steps')!=null?Math.round(avg('steps')).toLocaleString():'—';$('lb-garmin-calories').textContent=avg('calories')!=null?Math.round(avg('calories')).toLocaleString():'—';$('lb-garmin-sleep').textContent=avg('sleepHours')!=null?avg('sleepHours').toFixed(1)+' h':'—';$('lb-garmin-rhr').textContent=avg('restingHr')!=null?Math.round(avg('restingHr'))+' bpm':'—';setStatus('lb-garmin-status',days.length?days.length+' DAYS':'NOT IMPORTED');}
  $('lb-garmin-file-btn')?.addEventListener('click',()=>$('lb-garmin-file')?.click());
  $('lb-garmin-paste-btn')?.addEventListener('click',()=>{const text=$('lb-garmin-json')?.value.trim();if(!text){alert('Paste Garmin JSON first.');return}try{importGarmin(JSON.parse(text))}catch(e){alert('Invalid Garmin JSON.')}});
  $('lb-garmin-file')?.addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;try{importGarmin(JSON.parse(await f.text()))}catch(err){alert('Could not read Garmin JSON.')}e.target.value='';});
  function importGarmin(data){const p=profile();if(!p){return}if(!Array.isArray(data.days))throw new Error('Garmin JSON must contain a days array.');p.garmin={source:data.source||'Garmin Connect',owner:data.owner||p.name||'',month:data.month||'',generated:data.generated||'',units:data.units||{},importedAt:new Date().toISOString(),days:data.days.filter(x=>x&&(x.reportDate||x.activityDay)).map(x=>({...x,steps:Number.isFinite(Number(x.steps))?Number(x.steps):null,calories:Number.isFinite(Number(x.calories))?Number(x.calories):null,sleepHours:Number.isFinite(Number(x.sleepHours))?Number(x.sleepHours):null,restingHr:Number.isFinite(Number(x.restingHr))?Number(x.restingHr):null,avgStress:Number.isFinite(Number(x.avgStress))?Number(x.avgStress):null,bodyBatteryHigh:Number.isFinite(Number(x.bodyBatteryHigh))?Number(x.bodyBatteryHigh):null}))};window.leanBlendSaveProfile?.();renderGarmin();window.leanBlendRender?.();$('lb-garmin-note').textContent=`Imported ${p.garmin.days.length} Garmin daily records.`;}
  $('lb-garmin-clear')?.addEventListener('click',()=>{const p=profile();if(!p)return;if(confirm('Clear Garmin data for this profile?')){p.garmin={source:'Garmin Connect',importedAt:null,days:[]};window.leanBlendSaveProfile?.();renderGarmin();window.leanBlendRender?.()}});
  renderGarmin();
  // ---- LOCAL FOOD INTELLIGENCE REFRESH ----
  window.leanBlendRefreshAI=()=>{try{window.leanBlendRender?.();renderGarmin();renderWeeklyLocal(weeklyLocalStats(7))}catch(e){}};
  setTimeout(()=>window.leanBlendRefreshAI(),150);
})();
</script>

