function openCustomizer(){
 const modal=document.getElementById('customModal');
 const grid=document.getElementById('pickGrid');
 if(!grid.dataset.ready){
  const cats=[...new Set(customIngredients.map(x=>x.cat))];
  grid.innerHTML=cats.map(cat=>`<div><h3>${cat}</h3>${customIngredients.filter(x=>x.cat===cat).map((x,i)=>{
   const id='ci'+customIngredients.indexOf(x);
   return `<div class="pick" data-name="${x.n}" data-category="${x.cat}"><label><input type="checkbox" id="${id}" onchange="updateCustom()"> ${x.n}</label><small>${x.u}</small><input type="number" min="0" step="${x.u==='ml'?'5':'1'}" value="${x.q}" id="${id}q" oninput="updateCustom()" disabled></div>`;
  }).join('')}</div>`).join('');
  grid.dataset.ready='1';
  grid.querySelectorAll('input[type=checkbox]').forEach(cb=>cb.addEventListener('change',()=>{
   document.getElementById(cb.id+'q').disabled=!cb.checked; updateCustom();
  }));
 }
 modal.classList.add('open'); document.body.style.overflow='hidden';
}
function closeCustomizer(){document.getElementById('customModal').classList.remove('open');document.body.style.overflow='';}
function resetCustom(){
 document.querySelectorAll('#pickGrid input[type=checkbox]').forEach(x=>x.checked=false);
 document.querySelectorAll('#pickGrid input[type=number]').forEach((x,i)=>{x.disabled=true;x.value=customIngredients[i].q});
 document.getElementById('customOutput').innerHTML='';
 updateCustom();
}
function selectedCustom(){
 return customIngredients.map((x,i)=>({x,i})).filter(o=>document.getElementById('ci'+o.i)?.checked).map(o=>{
  const q=parseFloat(document.getElementById('ci'+o.i+'q').value)||0; return {...o.x,q};
 }).filter(o=>o.q>0);
}
function updateCustom(){
 let k=0,p=0,f=0,c=0,v=0;
 selectedCustom().forEach(x=>{k+=x.k*x.q/(x.u==='ml'?100:100);p+=x.p*x.q/(x.u==='ml'?100:100);f+=x.f*x.q/(x.u==='ml'?100:100);c+=x.c*x.q;});
 document.getElementById('cKcal').textContent=Math.round(k);
 document.getElementById('cProtein').textContent=p.toFixed(1);
 document.getElementById('cFibre').textContent=f.toFixed(1);
 document.getElementById('cCost').textContent='R'+Math.round(c);
 document.getElementById('cVol').textContent=Math.round(selectedCustom().reduce((s,x)=>s+(x.u==='ml'?x.q:0),0));
}
function buildCustomRecipe(){
 const s=selectedCustom();
 if(!s.length){document.getElementById('customOutput').innerHTML='<p>Please select at least one ingredient.</p>';return;}
 const ingredients=s.map(x=>`<li>${x.n} — <strong>${x.q} ${x.u}</strong></li>`).join('');
 document.getElementById('customOutput').innerHTML=`<div class="recipe-output"><h3>YOUR LEAN BLEND</h3><ul>${ingredients}</ul><p><strong>Method:</strong> Add liquid first, then soft ingredients, protein/boosters and fruit/veg. Blend until smooth. Add ice last and blend again. If too thick, add a small splash of water; if too thin, add ice.</p></div>`;
}
document.getElementById('customModal').addEventListener('click',e=>{if(e.target.id==='customModal')closeCustomizer();});
