 gut:["Low-fat Greek yoghurt","Chia seeds","Ground flaxseed","Rolled oats","Kiwi","Frozen raspberries","Frozen blueberries","Fresh ginger"],
 inflammation:["Frozen blueberries","Frozen raspberries","Frozen strawberries","Ground flaxseed","Chia seeds","Fresh ginger","Cinnamon","Unsweetened cocoa"],
 gentle:["Banana","Green apple","Cucumber","Rolled oats","Low-fat Greek yoghurt","Unsweetened almond milk","Ground flaxseed","Cinnamon"],
 satiety:["Vanilla whey","Chocolate whey","Low-fat Greek yoghurt","Low-fat cottage cheese","Chia seeds","Ground flaxseed","Rolled oats","Natural peanut butter"],
