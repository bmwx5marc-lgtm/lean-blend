<script id="lean-blend-basket-v16">
(function(){
  const ingredientAliases={
    "unsweetened almond milk":"Almond Breeze Unsweetened Original Almond Milk 1L",
    "almond milk":"Almond Breeze Unsweetened Original Almond Milk 1L",
    "greek yoghurt":"Greek Style Low Fat Plain Yoghurt 500g",
    "plain kefir":"Plain Kefir",
    "vanilla whey":"NPL Platinum Whey Vanilla 908g",
    "chocolate whey":"NPL Platinum Whey Chocolate 908g",
    "natural peanut butter":"Peanut Butter 400g",
    "peanut butter":"Peanut Butter 400g",
    "chia seeds":"Chia Seeds 250g",
    "chia":"Chia Seeds 250g",
    "rolled oats":"Rolled Oats 1kg",
    "oats":"Rolled Oats 1kg",
    "ground flax":"Ground Flaxseed 500g",
    "flax":"Ground Flaxseed 500g",
    "frozen blueberries":"Frozen Blueberries 500g",
    "blueberries":"Frozen Blueberries 500g",
    "frozen strawberries":"Frozen Strawberries 500g",
    "strawberries":"Frozen Strawberries 500g",
    "frozen raspberries":"Frozen Raspberries 500g",
    "raspberries":"Frozen Raspberries 500g",
    "frozen mango":"Frozen Mango 500g",
    "mango":"Frozen Mango 500g",
    "frozen pineapple":"Frozen Pineapple 500g",
    "pineapple":"Frozen Pineapple 500g",
    "low-fat milk":"Low-Fat Milk 1L",
    "coconut water":"Coconut Water 1L",
    "baby spinach":"Baby Spinach 100g",
    "spinach":"Baby Spinach 100g",
    "cucumber":"Cucumber",
    "banana":"Bananas",
    "green apple":"Green Apples",
    "apple":"Apples",
    "kiwi":"Kiwifruit",
    "pear":"Pears",
    "lemon":"Lemons",
    "lime":"Limes",
    "ginger":"Fresh Ginger",
    "mint":"Fresh Mint",
    "unsweetened cocoa":"Unsweetened Cocoa 100g",
    "cocoa":"Unsweetened Cocoa 100g",
    "cocoa nibs":"Cocoa Nibs 100g",
    "cinnamon":"Ground Cinnamon 50g",
    "nutmeg":"Ground Nutmeg 50g",
    "vanilla extract":"Vanilla Extract 50ml",
    "honey":"Honey 500g",
    "ice":"Ice",
    "water":"Still Water"
  };
  const unitWeights={
    "banana":120,"green apple":180,"apple":180,"kiwi":75,"pear":170,"cucumber":300,
    "lemon":80,"lime":70,"orange":150
  };
  const unitPacks={
    "almond milk":1000,"unsweetened almond milk":1000,"greek yoghurt":500,"plain kefir":500,
    "vanilla whey":908,"chocolate whey":908,"chia seeds":250,"chia":250,"rolled oats":1000,"oats":1000,
    "ground flax":500,"flax":500,"frozen blueberries":500,"blueberries":500,"frozen strawberries":500,
    "strawberries":500,"frozen raspberries":500,"raspberries":500,"frozen mango":500,"mango":500,
    "frozen pineapple":500,"pineapple":500,"low-fat milk":1000,"coconut water":1000,"spinach":100,
    "baby spinach":100,"unsweetened cocoa":100,"cocoa":100,"cocoa nibs":100,"cinnamon":50,"nutmeg":50,
    "vanilla extract":50,"honey":500
  };
  const recipes=[...document.querySelectorAll('article.recipe[data-code]')];
  const state=new Set();
  const box=document.getElementById('basket-recipes');
  if(!box)return;
  recipes.forEach(a=>{
    const code=a.dataset.code, name=a.dataset.name||code;
    const label=document.createElement('label'); label.style.cssText='display:flex;gap:7px;align-items:flex-start;padding:7px;border:1px solid #ddd;border-radius:9px;font-size:12px';
    label.innerHTML='<input type="checkbox" data-basket-code="'+code+'"> <span><b>'+code+'</b> '+name.replace(/\b\w/g,m=>m.toUpperCase())+'</span>';
    box.appendChild(label);
    label.querySelector('input').addEventListener('change',e=>{e.target.checked?state.add(code):state.delete(code);render();});
  });
  function parseQty(text){
    const m=text.trim().match(/^([0-9.]+)\s*(ml|g|kg|l)?$/i); if(!m)return null;
    let n=parseFloat(m[1]),u=(m[2]||'').toLowerCase(); if(u==='kg')n*=1000,u='g'; if(u==='l')n*=1000,u='ml'; return {n,u};
  }
  function aggregate(){
    const out={};
    recipes.filter(a=>state.has(a.dataset.code)).forEach(a=>{
      a.querySelectorAll('.recipe-cols section:first-child li').forEach(li=>{
        const n=(li.querySelector('span')?.textContent||'').trim().toLowerCase();
        const q=(li.querySelector('strong')?.textContent||'').trim(); const parsed=parseQty(q); if(!n||!parsed)return;
        const key=n;
        if(!out[key])out[key]={n,ml:0,g:0};
        if(parsed.u==='ml')out[key].ml+=parsed.n; else if(parsed.u==='g')out[key].g+=parsed.n;
      });
    });
    return out;
  }
  function packInfo(k,v){
    const alias=ingredientAliases[k]||k.replace(/\b\w/g,m=>m.toUpperCase());
    if(unitWeights[k]){ const units=Math.max(1,Math.ceil((v.g||v.ml)/unitWeights[k])); return {alias,order:units+' × '+alias}; }
    const pack=unitPacks[k]; if(pack){ const need=v.ml||v.g; const units=Math.max(1,Math.ceil(need/pack)); return {alias,order:units+' × '+alias}; }
    const need=v.ml?Math.ceil(v.ml)+' ml':Math.ceil(v.g)+' g'; return {alias,order:need+' '+alias};
  }
  function searchUrl(retailer,item){
    const q=encodeURIComponent(item.alias);
    if(retailer==='woolworths')return 'https://www.woolworths.co.za/c/shop/_/N-1z13p9n';
    if(retailer==='checkers')return 'https://www.sixty60.co.za/';
    if(retailer==='pnp')return 'https://www.pnp.co.za/';
    return 'https://www.google.com/search?q='+q+'+grocery+South+Africa';
  }
  function render(){
    const data=aggregate(), rows=Object.keys(data).map(k=>({k,...packInfo(k,data[k])}));
    const el=document.getElementById('basket-summary');
    if(!rows.length){el.innerHTML='<p>Select one or more recipes above. Duplicate ingredients will be combined automatically.</p>';return;}
    el.innerHTML='<div style="font-size:12px"><b>'+rows.length+' shopping lines</b><br><br>'+rows.map(x=>'<div style="display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid #eee"><span>'+x.alias+'</span><b>'+x.order.replace(x.alias,'').trim()+'</b></div>').join('')+'</div>';
  }
  document.getElementById('basket-copy').addEventListener('click',async()=>{
    const data=aggregate(), rows=Object.keys(data).map(k=>({k,...packInfo(k,data[k])}));
    const retailer=document.getElementById('basket-retailer').selectedOptions[0].textContent;
    const text='LEAN BLEND SHOPPING BASKET — '+retailer+'\n\n'+rows.map(x=>'[ ] '+x.order).join('\n');
    await navigator.clipboard?.writeText(text); const b=document.getElementById('basket-copy'); b.textContent='COPIED ✓'; setTimeout(()=>b.textContent='COPY ORDER',1200);
  });
  document.getElementById('basket-open').addEventListener('click',()=>{
    const data=aggregate(), retailer=document.getElementById('basket-retailer').value;
    Object.keys(data).slice(0,12).forEach((k,i)=>{const item=packInfo(k,data[k]); setTimeout(()=>window.open(searchUrl(retailer,item),'_blank'),i*180);});
  });
  document.getElementById('basket-clear').addEventListener('click',()=>{state.clear();box.querySelectorAll('input').forEach(x=>x.checked=false);render();});
  render();
})();
</script>
<script id="lean-blend-users-v2">
(function(){
 const KEY='leanBlendProfilesV1';
 const DEFAULT_ID='bigfish_default';
 let db=JSON.parse(localStorage.getItem(KEY)||'{}'); let currentId=localStorage.getItem('leanBlendCurrentProfile')||'';
 const $=id=>document.getElementById(id);
 function initialiseSingleUser(){try{let source=db?.[DEFAULT_ID]||(currentId&&db?.[currentId])||(db&&Object.keys(db).length?db[Object.keys(db)[0]]:null)||blank();if(!Array.isArray(source.measurements))source.measurements=[];if(!Array.isArray(source.orders))source.orders=[];if(!Array.isArray(source.foodLog))source.foodLog=[];if(!source.garmin)source.garmin={source:'Garmin Connect',importedAt:null,days:[]};source.name='BIGFISH';db={[DEFAULT_ID]:source};currentId=DEFAULT_ID;localStorage.setItem(KEY,JSON.stringify(db));localStorage.setItem('leanBlendCurrentProfile',DEFAULT_ID)}catch(e){db={[DEFAULT_ID]:blank()};db[DEFAULT_ID].name='BIGFISH';currentId=DEFAULT_ID;try{localStorage.setItem(KEY,JSON.stringify(db));localStorage.setItem('leanBlendCurrentProfile',DEFAULT_ID)}catch(_){} }}
 const today=new Date().toISOString().slice(0,10); $('lb-measure-date').value=today; $('lb-order-date').value=today; $('lb-food-date').value=today;
 function save(){localStorage.setItem(KEY,JSON.stringify(db)); if(currentId)localStorage.setItem('leanBlendCurrentProfile',currentId);} window.leanBlendSaveProfile=save;
 function blank(){return {name:'',age:null,gender:'',height:null,target:null,currentWeight:null,activity:'general',trainingDays:0,calorieTarget:null,measurements:[],orders:[],foodLog:[],garmin:{source:'Garmin Connect',importedAt:null,days:[]}};}
 function profile(){
   // Rehydrate from localStorage on every lookup so profiles created/selected by
   // another handler are immediately visible to the in-memory profile engine.
   try{
     const fresh=JSON.parse(localStorage.getItem(KEY)||'{}')||{};
     const freshId=localStorage.getItem('leanBlendCurrentProfile')||'';
     if(JSON.stringify(fresh)!==JSON.stringify(db)) db=fresh;
     if(freshId && freshId!==currentId) currentId=freshId;
   }catch(e){}
   if(currentId && db[currentId]) return db[currentId];
   const ids=Object.keys(db);
   if(ids.length){
     currentId=ids[0];
     save();
     return db[currentId];
   }
   const name=($('lb-user-name')?.value||'').trim();
   if(name){
     const id='u_'+Date.now();
     const p=blank();
     p.name=name;
     p.age=$('lb-age')?.value?Number($('lb-age').value):null;
     p.gender=$('lb-gender')?.value||'';
     p.height=$('lb-height')?.value?Number($('lb-height').value):null;
     p.target=$('lb-target')?.value?Number($('lb-target').value):null;
     p.activity=$('lb-activity')?.value||'general';
     p.trainingDays=$('lb-training-days')?.value?Number($('lb-training-days').value):0;
     p.calorieTarget=$('lb-calorie-target')?.value?Number($('lb-calorie-target').value):null;
     const w=$('lb-current-weight-input')?.value?Number($('lb-current-weight-input').value):NaN;
     if(Number.isFinite(w)&&w>0){p.currentWeight=w;p.measurements.push({date:today,weight:w,fat:'',water:''});}
     db[id]=p; currentId=id; save(); refreshSelect();
     return p;
   }
   if(!db[DEFAULT_ID])db[DEFAULT_ID]=blank();db[DEFAULT_ID].name='BIGFISH';currentId=DEFAULT_ID;save();return db[DEFAULT_ID];
 }
 function refreshSelect(){const sel=$('lb-user-select');if(!sel)return;sel.innerHTML='<option value="'+DEFAULT_ID+'">BIGFISH</option>';sel.value=DEFAULT_ID;}
