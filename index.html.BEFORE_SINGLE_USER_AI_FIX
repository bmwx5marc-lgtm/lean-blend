<script id="lean-blend-v27-3-capture-guard">
(function(){
  'use strict';
  function boot(){
    const btn=document.getElementById('lb-v25-analyse');
    if(!btn)return;
    // Guaranteed visible click path: if the main AI core is loaded, call its
    // canonical capture function. Otherwise show a diagnostic instead of silently doing nothing.
    btn.type='button';
    btn.dataset.aiWired='true';
    btn.addEventListener('click',function(ev){
      if(typeof window.leanBlendAnalyseCapture==='function') return;
      ev.preventDefault();ev.stopImmediatePropagation();
      const status=document.getElementById('lb-v25-status');
      if(status)status.textContent='AI ENGINE NOT LOADED';
      alert('LEAN BLEND AI engine did not load. The deployed page is not running the final V27.4 build.');
    },true);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot); else boot();
})();
</script>
